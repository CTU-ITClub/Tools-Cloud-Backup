{
  "name": "itclub-media-cloud",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "backup:daemon": "node --env-file=.env scripts/backup-daemon.cjs",
    "backup:once": "node --env-file=.env scripts/backup-daemon.cjs --once",
    "backup:oauth": "node --env-file=.env scripts/google-drive-auth.cjs",
    "backup:restore": "node --env-file=.env scripts/restore-backup.cjs",
    "backup:restore-media": "node --env-file=.env scripts/restore-media.cjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "koffi": "^2.14.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "fflate": "^0.8.2",
    "mammoth": "^1.9.0",
    "dompurify": "^3.2.6",
    "exceljs": "^4.4.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
